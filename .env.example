# Root environment file consumed by docker-compose.yml.
# Copy to `.env` and adjust before running `docker compose up`.

# --- PostgreSQL ---
POSTGRES_USER=docentra
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=docentra

# --- Backend ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
APP_URL=http://localhost:4000
WEB_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Object storage: local disk (default) or s3-compatible (MinIO is bundled below)
STORAGE_DRIVER=local
# To use the bundled MinIO instead, set STORAGE_DRIVER=s3 and use these:
S3_BUCKET=docentra-documents
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=docentra
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_FORCE_PATH_STYLE=true

# --- MinIO (S3-compatible object storage, optional) ---
MINIO_ROOT_USER=docentra
MINIO_ROOT_PASSWORD=change-me-minio-secret

# --- Email (optional; logs to console in dev mode if unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Docentra <no-reply@docentra.local>

# --- Web build ---
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/
