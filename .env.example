# Root-level environment reference. Each app also has its own .env.example
# (apps/api/.env.example, apps/web/.env.example) with app-specific values —
# copy those into apps/api/.env and apps/web/.env for local development.
# This file documents the shared infrastructure values used by
# docker-compose.yml.

