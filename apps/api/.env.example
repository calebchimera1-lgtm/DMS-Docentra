NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://omniflow:omniflow@localhost:5432/omniflow?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_NODE=http://localhost:9200

# Object storage (S3-compatible / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=omniflow
S3_ACCESS_KEY_ID=omniflow
S3_SECRET_ACCESS_KEY=change-me

# Auth
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_MFA_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM key used to encrypt MFA secrets at rest (any secret string —
# it's stretched to 32 bytes via scrypt, doesn't need to be exactly 32 bytes)
ENCRYPTION_KEY=change-me

# OAuth (optional — leave unset to disable; the /auth/oauth/google routes
# only register when both client credentials are present)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/google/callback
